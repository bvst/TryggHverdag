{
  "name": "trygghverdag",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.13.0 <23",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "doctor": "node scripts/doctor.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "turbo run typecheck",
    "imports:check": "depcruise --config .dependency-cruiser.cjs .claude/hooks apps packages scripts",
    "test:hooks": "vitest run .claude/hooks",
    "test:unit": "vitest run && pnpm --filter @trygghverdag/mobile --fail-if-no-match run test",
    "test:integration": "vitest run --config vitest.integration.config.mjs",
    "test:system": "vitest run --config vitest.system.config.mjs",
    "test:coverage": "vitest run --coverage --config vitest.coverage.config.mjs && pnpm --filter @trygghverdag/mobile --fail-if-no-match run test:coverage",
    "e2e:android": "node scripts/e2e-android.mjs",
    "dev": "pnpm --filter @trygghverdag/mobile run start",
    "gate:file": "node scripts/gate-file.mjs",
    "gate:static": "pnpm run format:check && pnpm run typecheck && pnpm run lint && pnpm run imports:check && pnpm run infra:check",
    "gate:quick": "node scripts/gate.mjs quick",
    "gate:integrity": "node scripts/gate-integrity.mjs",
    "req:coverage": "node scripts/req-coverage.mjs",
    "tests:changes": "node scripts/tests-changes.mjs",
    "coverage:ratchet": "node scripts/coverage-ratchet.mjs",
    "licenses:check": "node scripts/licenses-check.mjs",
    "api:diff": "node scripts/api-diff.mjs",
    "api:spec": "node scripts/api-spec.mjs",
    "mutation": "node scripts/mutation.mjs",
    "gate:full": "node scripts/gate.mjs full",
    "gate:drills": "node scripts/gate-drills.mjs",
    "infra:check": "node scripts/infra-check.mjs",
    "smoke": "node scripts/smoke.mjs"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^10.0.0",
    "@trygghverdag/config": "workspace:*",
    "@vitest/coverage-v8": "^5.0.1",
    "dependency-cruiser": "^18.4.0",
    "eslint": "^10.11.0",
    "prettier": "^3.9.8",
    "turbo": "^2.11.2",
    "typescript": "catalog:",
    "vitest": "^5.0.1"
  },
  "pnpm": {
    "packageExtensions": {
      "react-native-drawer-layout": {
        "peerDependenciesMeta": {
          "react-native-gesture-handler": {
            "optional": true
          },
          "react-native-reanimated": {
            "optional": true
          }
        }
      }
    },
    "overrides": {
      "source-map-js@<1.2.2": "1.2.2"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-86w9-cpqp-85rv",
        "GHSA-vfj7-8cjw-p6xm"
      ]
    }
  }
}

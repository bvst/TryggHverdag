    "/heartbeats": {
      "post": {
        "operationId": "recordHeartbeat",
        "summary": "Send a heartbeat",
        "description": "Needs a device credential. Answers only for the device user’s own journeys, and only from the device that started the journey. A 200, RECORDED or DUPLICATE, means the server has the event, so the phone may drop it. A 409 means the journey has ended: stop sending.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "journeyId": {
                    "type": "string",
                    "format": "uuid",
                    "description": "The journey this heartbeat belongs to."
                  },
                  "eventId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64,
                    "pattern": "^[A-Za-z0-9-]+$",
                    "description": "The heartbeat’s own ID, unique within its journey. Sent again, it changes nothing and is answered DUPLICATE (SM-08)."
                  },
                  "batteryLevel": {
                    "anyOf": [
                      {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "description": "The battery level from 0 to 1, or null when the phone does not know it."
                  },
                  "position": {
                    "anyOf": [
                      {
                        "type": "object",
                        "properties": {
                          "latitude": {
                            "type": "number",
                            "minimum": -90,
                            "maximum": 90,
                            "description": "Degrees, from -90 to 90."
                          },
                          "longitude": {
                            "type": "number",
                            "minimum": -180,
                            "maximum": 180,
                            "description": "Degrees, from -180 to 180."
                          },
                          "accuracyMeters": {
                            "type": "number",
                            "minimum": 0,
                            "description": "The position’s accuracy in metres, 0 or more."
                          },
                          "recordedAt": {
                            "type": "string",
                            "format": "date-time",
                            "description": "When the phone recorded the position, by the phone’s clock, as RFC 3339 with an offset, whose instant in UTC falls in the years 0001 to 9999. Within those years, any time is accepted, however far from the server’s clock: it labels the position and decides nothing (REL-01)."
                          }
                        },
                        "required": [
                          "latitude",
                          "longitude",
                          "accuracyMeters",
                          "recordedAt"
                        ],
                        "additionalProperties": false,
                        "description": "Where the phone was, as the phone recorded it."
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "description": "The position, or null when the phone has none (SM-03)."
                  }
                },
                "required": [
                  "journeyId",
                  "eventId",
                  "batteryLevel",
                  "position"
                ],
                "additionalProperties": false,
                "description": "A heartbeat. The walker is the user whose device sends it, and the device must be the one that started the journey; no field names either."
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The server has the heartbeat, so the phone may drop it.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "outcome": {
                      "enum": [
                        "RECORDED",
                        "DUPLICATE"
                      ],
                      "type": "string",
                      "description": "RECORDED when the heartbeat was stored now; DUPLICATE when its journey already had its event ID, so nothing changed."
                    }
                  },
                  "required": [
                    "outcome"
                  ],
                  "description": "The server has the heartbeat, so the phone may drop it."
                }
              }
            }
          },
          "400": {

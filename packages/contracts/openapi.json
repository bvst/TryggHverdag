{
  "info": {
    "title": "TryggHverdag API",
    "version": "v1",
    "description": "The server that watches journeys home. Every route lives under /v1; a breaking change gets a new version rather than changing this one, because phones keep running old app versions (AR-08)."
  },
  "servers": [
    {
      "url": "/v1"
    }
  ],
  "components": {
    "securitySchemes": {
      "deviceCredential": {
        "type": "http",
        "scheme": "bearer",
        "description": "The device’s own credential, sent as `Authorization: Bearer <credential>`. The server keeps only its hash."
      }
    }
  },
  "openapi": "3.1.1",
  "paths": {
    "/health": {
      "get": {
        "operationId": "health",
        "summary": "Is the safety system working?",
        "description": "Returns 200 whenever the API is up. Read `status` in the body to tell whether the worker is still running, because an API with no worker raises no alerts.",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "enum": [
                        "ok",
                        "degraded"
                      ],
                      "type": "string",
                      "description": "ok when the worker has checked in recently; degraded when it has not, which means nothing is watching the journeys."
                    },
                    "checkedAt": {
                      "type": "string",
                      "format": "date-time",
                      "description": "When the server answered, from the database clock (REL-01), as RFC 3339."
                    },
                    "worker": {
                      "type": "object",
                      "properties": {
                        "lastBeatAt": {
                          "anyOf": [
                            {
                              "type": "string",
                              "format": "date-time"
                            },
                            {
                              "type": "null"
                            }
                          ],
                          "description": "The worker’s last check-in, or null if it has never checked in."
                        },
                        "silentForMs": {
                          "anyOf": [
                            {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 9007199254740991
                            },
                            {
                              "type": "null"
                            }
                          ],
                          "description": "How long the worker has been silent, or null if it has never checked in."
                        }
                      },
                      "required": [
                        "lastBeatAt",
                        "silentForMs"
                      ],
                      "description": "What the API can see of the worker."
                    }
                  },
                  "required": [
                    "status",
                    "checkedAt",
                    "worker"
                  ],
                  "description": "Whether the safety system as a whole is working, not just this process."
                }
              }
            }
          }
        }
      }
    },
    "/journeys": {
      "post": {
        "operationId": "startJourney",
        "summary": "Start a journey",
        "description": "Needs a device credential: the walker is the user whose device sends it. A walker can have only one unended journey, so a second start is refused with 409 and the ID of the journey already running.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "responderIds": {
                    "type": "array",
                    "maxItems": 50,
                    "items": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "description": "The users who should follow this journey. Each must be an existing user other than the walker; a repeated ID counts once. An empty list is accepted here and refused as NO_RESPONDER."
                  }
                },
                "required": [
                  "responderIds"
                ],
                "additionalProperties": false,
                "description": "A start request. The walker is the user whose device sends it; no field names one."
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The journey started.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "journeyId": {
                      "type": "string",
                      "format": "uuid",
                      "description": "The new journey."
                    },
                    "state": {
                      "const": "ACTIVE",
                      "description": "A journey starts ACTIVE."
                    },
                    "startedAt": {
                      "type": "string",
                      "format": "date-time",
                      "description": "When the journey started, from the database clock (REL-01), as RFC 3339."
                    }
                  },
                  "required": [
                    "journeyId",
                    "state",
                    "startedAt"
                  ],
                  "description": "The journey that started."
                }
              }
            }
          },
          "400": {
            "description": "400",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "type": "object",
                      "properties": {
                        "defined": {
                          "const": true
                        },
                        "code": {
                          "const": "BAD_REQUEST"
                        },
                        "status": {
                          "const": 400
                        },
                        "message": {
                          "type": "string",
                          "default": "Input validation failed"
                        },
                        "data": {}
                      },
                      "required": [
                        "defined",
                        "code",
                        "status",
                        "message"
                      ]
                    },
                    {
                      "type": "object",
                      "properties": {
                        "defined": {
                          "const": false
                        },
                        "code": {
                          "type": "string"
                        },
                        "status": {
                          "type": "number"
                        },
                        "message": {
                          "type": "string"
                        },
                        "data": {}
                      },
                      "required": [
                        "defined",
                        "code",
                        "status",
                        "message"
                      ]
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "description": "401",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "type": "object",
                      "properties": {
                        "defined": {
                          "const": true
                        },
                        "code": {
                          "const": "UNAUTHORIZED"
                        },
                        "status": {
                          "const": 401
                        },
                        "message": {
                          "type": "string",
                          "default": "A valid device credential is required."
                        },
                        "data": {}
                      },
                      "required": [
                        "defined",
                        "code",
                        "status",
                        "message"
                      ]
                    },
                    {
                      "type": "object",
                      "properties": {
                        "defined": {
                          "const": false
                        },
                        "code": {
                          "type": "string"
                        },
                        "status": {
                          "type": "number"
                        },
                        "message": {
                          "type": "string"
                        },
                        "data": {}
                      },
                      "required": [
                        "defined",
                        "code",
                        "status",
                        "message"
                      ]
                    }
                  ]
                }
              }
            }
          },
          "409": {
            "description": "409",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "type": "object",
                      "properties": {
                        "defined": {
                          "const": true
                        },
                        "code": {
                          "const": "ALREADY_ON_A_JOURNEY"
                        },
                        "status": {
                          "const": 409
                        },
                        "message": {
                          "type": "string",
                          "default": "The walker already has a journey that has not ended."
                        },
                        "data": {
                          "type": "object",
                          "properties": {
                            "journeyId": {
                              "type": "string",
                              "format": "uuid",
                              "description": "The walker’s own unended journey."
                            }
                          },
                          "required": [
                            "journeyId"
                          ]
                        }
                      },
                      "required": [
                        "defined",
                        "code",
                        "status",
                        "message",
                        "data"
                      ]
                    },
                    {
                      "type": "object",
                      "properties": {
                        "defined": {
                          "const": false
                        },
                        "code": {
                          "type": "string"
                        },
                        "status": {
                          "type": "number"
                        },
                        "message": {
                          "type": "string"
                        },
                        "data": {}
                      },
                      "required": [
                        "defined",
                        "code",
                        "status",
                        "message"
                      ]
                    }
                  ]
                }
              }
            }
          },
          "422": {
            "description": "422",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "type": "object",
                      "properties": {
                        "defined": {
                          "const": true
                        },
                        "code": {
                          "const": "INVALID_RESPONDER"
                        },
                        "status": {
                          "const": 422
                        },
                        "message": {
                          "type": "string",
                          "default": "A responder named is the walker, or is not a user."
                        },
                        "data": {}
                      },
                      "required": [
                        "defined",
                        "code",
                        "status",
                        "message"
                      ]
                    },
                    {
                      "type": "object",
                      "properties": {
                        "defined": {
                          "const": true
                        },
                        "code": {
                          "const": "NO_RESPONDER"
                        },
                        "status": {
                          "const": 422
                        },
                        "message": {
                          "type": "string",
                          "default": "A journey needs at least one responder to start."
                        },
                        "data": {}
                      },
                      "required": [
                        "defined",
                        "code",
                        "status",
                        "message"
                      ]
                    },
                    {
                      "type": "object",
                      "properties": {
                        "defined": {
                          "const": false
                        },
                        "code": {
                          "type": "string"
                        },
                        "status": {
                          "type": "number"
                        },
                        "message": {
                          "type": "string"
                        },
                        "data": {}
                      },
                      "required": [
                        "defined",
                        "code",
                        "status",
                        "message"
                      ]
                    }
                  ]
                }
              }
            }
          }
        },
        "security": [
          {
            "deviceCredential": []
          }
        ]
      }
    }
  }
}

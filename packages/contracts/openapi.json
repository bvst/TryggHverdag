    "/journeys/{journeyId}/home": {
      "post": {
        "operationId": "reportHome",
        "summary": "Say \"I’m home\"",
        "description": "Needs a device credential. Ends the journey named in the path; only the device that started the journey may end it. The body is empty, or absent. A 200, ENDED, and a 409, JOURNEY_ENDED, both mean the journey is over: stop tracking it and drop anything queued for it.",
        "parameters": [
          {
            "name": "journeyId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "description": "The journey to end."
            }
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "description": "Nothing: an empty object, or no body at all."
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The journey ended now.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "outcome": {
                      "const": "ENDED",
                      "description": "The journey ended now."
                    }
                  },
                  "required": [
                    "outcome"
                  ],
                  "description": "The journey is over, so the phone may stop tracking it."
                }
              }

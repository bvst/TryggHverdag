# Dependencies and build output
node_modules/
dist/
build/
coverage/
.turbo/

# Claude Code session state (07b README: never committed)
.claude/state/

# Local environment and secrets — never committed (SEC-03)
.env
.env.*
!.env.example

# Tooling caches
*.tsbuildinfo
.eslintcache
.stryker-tmp/
reports/
# Vitest's module cache (D-124) is made inside Stryker's sandbox; this is the
# backstop for a run ever made outside one.
.vitest-fs-cache/

# Expo / native build output (from INF-06)
.expo/
apps/mobile/ios/
apps/mobile/android/
# The same for the throwaway app of SPIKE-01, which is built outside the workspace
spikes/background-safety/app/ios/
spikes/background-safety/app/android/

# Editors and OS
.DS_Store
*.log

# Terraform (infra/). The lock file is committed; nothing else here is.
# State holds the database password, so it lives in Cellar (A-20) and never in
# git — even a stray local copy is ignored rather than trusted not to be added.
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log

# Written by `clever link` in deploy-staging.yml; names an app, holds no secret, but
# belongs to one checkout only.
.clever.json

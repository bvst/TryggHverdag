# engine-strict makes pnpm refuse to install on a Node this repository does not
# support. The upper bound that used to sit in package.json's engines.node was
# a third guard on top of .nvmrc and doctor, and it was the one that stopped
# Dependabot: its updater runs Node 24, read `<23`, and refused to touch the
# npm dependencies at all — so the security updates SEC-06 relies on would
# never have arrived. See D-064.
engine-strict=true

# Changes to these paths need a code owner's approval before merge (D-042).
# Everything else auto-merges when all required checks pass.
#
# Two owners, and the second one is not decoration: GitHub does not let anyone
# approve their own pull request, and this repository's pull requests are
# opened by @bvst. With @bvst alone listed, the code-owner gate could never be
# satisfied on the work that actually happens here — it would be a rule that
# blocks everything rather than a rule that checks anything. @urso-agent is the
# owner's second account and exists for exactly this. See D-071.
/apps/server/src/domain/          @bvst @urso-agent
/apps/server/src/modules/alerts/  @bvst @urso-agent
/apps/server/src/worker.ts        @bvst @urso-agent
# Where a stopped worker is made to exit with 1, so it is restarted (D-077).
/apps/server/src/bin/worker.ts    @bvst @urso-agent
/apps/server/src/process.ts       @bvst @urso-agent
# The one file that can ping Healthchecks.io: an unasked ping keeps a dead worker's check green (D-079).
/apps/server/src/adapters/healthchecks.ts       @bvst @urso-agent
# Where the journey guarantees live: the responder insert and its transaction,
# the one-unended-journey index, the device-credential check, and where the
# database clock is wired into the API's services (D-092, D-094, D-095).
/apps/server/src/adapters/journeys.ts           @bvst @urso-agent
/apps/server/src/adapters/device-credentials.ts @bvst @urso-agent
/apps/server/src/db/schema.ts     @bvst @urso-agent
/apps/server/src/db/migrations/   @bvst @urso-agent
/apps/server/src/modules/journeys/ @bvst @urso-agent
/apps/server/src/api-process.ts   @bvst @urso-agent
# The device-credential middleware and the walker always the device's own user,
# the database clock itself, and where the migrations are read from and written
# to (D-097).
/apps/server/src/api.ts                    @bvst @urso-agent
/apps/server/src/adapters/clock.ts         @bvst @urso-agent
/apps/server/src/adapters/migrations.ts    @bvst @urso-agent
/apps/server/drizzle.config.ts             @bvst @urso-agent
/apps/mobile/src/safety-core/     @bvst @urso-agent
# Where the app's permissions, background modes, backup and deep links are set;
# background location is what the safety core stands on (D-084).
/apps/mobile/app.config.ts        @bvst @urso-agent
/.github/                         @bvst @urso-agent
/.claude/                         @bvst @urso-agent
# Loaded into every agent session, and states the non-negotiables and the
# binding-decisions rule. As governance-critical as anything under /.claude/.
/CLAUDE.md                        @bvst @urso-agent
/scripts/                         @bvst @urso-agent
# HK-09's entry point. Its rules live in /scripts/ and were already owned, but
# git executes this file: an unowned copy could switch the gate off without the
# rules changing a line.
/.githooks/                       @bvst @urso-agent
/package.json                     @bvst @urso-agent
# Their include and exclude lists decide which tests CI runs at all, the gate
# drills among them (D-082).
/vitest.config.mjs                @bvst @urso-agent
/vitest.shared.mjs                @bvst @urso-agent
/vitest.coverage.config.mjs       @bvst @urso-agent
# They decide what the system (L6) and integration (L3) tests collect: the
# journey module's mutation run, and the database files' only tests (D-096).
/vitest.system.config.mjs         @bvst @urso-agent
/vitest.integration.config.mjs    @bvst @urso-agent
# They decide what the lint, import-rule, mutation and coverage gates check, so
# a change to one can loosen a gate without any test changing (D-084).
/eslint.config.mjs                @bvst @urso-agent
/.dependency-cruiser.cjs          @bvst @urso-agent
/stryker.config.mjs               @bvst @urso-agent
/coverage-baseline.json           @bvst @urso-agent
/packages/config/                 @bvst @urso-agent
/packages/contracts/released/     @bvst @urso-agent
/docs/plan/decisions.md           @bvst @urso-agent
/infra/                           @bvst @urso-agent

# Reviewer memory changes often and needs no approval (last match wins).
/.claude/agent-memory/
